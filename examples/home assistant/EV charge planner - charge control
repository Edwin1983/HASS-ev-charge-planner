# EV Charge Planner – charger control example
#
# This is an example automation showing how EV Charge Planner outputs can be
# translated into physical charger settings.
#
# IMPORTANT:
# - Replace all example entity IDs with the entities from your own installation.
# - EV Charge Planner itself does NOT control the physical charger.
# - This example assumes a charger integration that exposes a charging-current
#   number entity and a separate 1-phase / 3-phase selection entity.
# - In this example the phase selector uses 32 = 1 phase and 0 = 3 phases.
#   Your charger/integration may use completely different values.
#
# The automation reacts to the two native EV Charge Planner output sensors:
#   sensor.ev_planner_desired_phase
#   sensor.ev_planner_desired_current
#
# The example also uses a local boolean as the physical charging permission.
# That boolean is deliberately NOT part of EV Charge Planner.

alias: EV Charge Planner - Charger control example
description: >-
  Example automation that applies the planner's desired charging current and
  phase to a compatible EV charger.

triggers:
  # Re-evaluate the charger whenever the planner changes its desired current
  # or phase.
  - trigger: state
    entity_id:
      - sensor.ev_planner_desired_phase
      - sensor.ev_planner_desired_current

conditions:
  # Only operate the charger while the EV is connected according to the
  # charger's own status entity.
  # Replace this entity and states with those provided by your charger.
  - condition: state
    entity_id: sensor.ev_charger_status
    state:
      - connected_charging
      - connected_finished
      - connected_requesting

actions:
  - variables:
      # Desired values produced by EV Charge Planner.
      desired_phase: "{{ states('sensor.ev_planner_desired_phase') | int(0) }}"
      desired_current: "{{ states('sensor.ev_planner_desired_current') | int(0) }}"

      # Current charger settings.
      current_current: "{{ states('number.ev_charger_max_current') | int(0) }}"
      phase_selector: "{{ states('number.ev_charger_phase_switch') | int(32) }}"

      # Translate the example phase-selector values into a phase count.
      # IMPORTANT: adapt this mapping to your charger integration.
      current_phase: >-
        {% if phase_selector == 32 %}
          1
        {% elif phase_selector == 0 %}
          3
        {% else %}
          0
        {% endif %}

      phase_change_required: >-
        {{ desired_phase in [1, 3] and desired_phase != current_phase }}

      current_change_required: >-
        {{ desired_current >= 6 and desired_current <= 16
           and desired_current != current_current }}

  # The example only applies valid planner output values.
  # The planner normally produces 6–16 A and either 1 or 3 phases.
  - condition: template
    value_template: "{{ desired_phase in [1, 3] }}"

  - condition: template
    value_template: "{{ desired_current >= 6 and desired_current <= 16 }}"

  - choose:
      - conditions:
          - condition: template
            value_template: "{{ phase_change_required }}"
        sequence:
          # Stop charging permission before changing phases. This is a local
          # installation-specific helper and is NOT controlled by the planner.
          - action: input_boolean.turn_off
            target:
              entity_id: input_boolean.ev_charging_allowed

          # Wait until the charger has stopped delivering energy before changing
          # the electrical phase configuration.
          - wait_template: >-
              {{ states('sensor.ev_charger_status') != 'charging' }}
            timeout: "00:00:30"
            continue_on_timeout: false

          - delay:
              seconds: 2

          - choose:
              - conditions:
                  - condition: template
                    value_template: "{{ desired_phase == 1 }}"
                sequence:
                  # Example: 32 means 1 phase on this type of phase selector.
                  - action: number.set_value
                    target:
                      entity_id: number.ev_charger_phase_switch
                    data:
                      value: 32

              - conditions:
                  - condition: template
                    value_template: "{{ desired_phase == 3 }}"
                sequence:
                  # Example: 0 means 3 phases on this type of phase selector.
                  - action: number.set_value
                    target:
                      entity_id: number.ev_charger_phase_switch
                    data:
                      value: 0

          # Allow the charger integration a moment to apply the phase change.
          - delay:
              seconds: 5

          # Verify that the requested phase selector value was accepted.
          - wait_template: >-
              {{
                (desired_phase == 1 and
                  states('number.ev_charger_phase_switch') | int(0) == 32)
                or
                (desired_phase == 3 and
                  states('number.ev_charger_phase_switch') | int(0) == 0)
              }}
            timeout: "00:00:15"
            continue_on_timeout: false

  - choose:
      - conditions:
          # Change the current when required. A phase change also causes the
          # current to be written again so both planner outputs are applied.
          - condition: template
            value_template: "{{ current_change_required or phase_change_required }}"
        sequence:
          - action: number.set_value
            target:
              entity_id: number.ev_charger_max_current
            data:
              value: "{{ desired_current }}"

          - delay:
              seconds: 2

  # Finally restore the local charging permission.
  - action: input_boolean.turn_on
    target:
      entity_id: input_boolean.ev_charging_allowed

mode: queued
max: 3
max_exceeded: silent
